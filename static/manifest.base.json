{
  "manifest_version": 3,
  "name": "Rolling Weeks for Proton Calendar",
  "short_name": "Rolling Weeks",
  "version": "0.1.0",
  "description": "Shows a rolling multi-week view in Proton Calendar. Unofficial; not affiliated with Proton AG.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://calendar.proton.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://calendar.proton.me/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Rolling Weeks",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "apply-rolling-view": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Apply the rolling multi-week view"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
